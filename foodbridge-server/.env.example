PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Primary (SRV) — from Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/foodbridge?retryWrites=true&w=majority

# Fallback if querySrv ECONNREFUSED — from Atlas → Connect → Compass (mongodb:// string)
# MONGO_URI_STANDARD=mongodb://USERNAME:PASSWORD@host1:27017,host2:27017,host3:27017/foodbridge?ssl=true&authSource=admin&replicaSet=atlas-xxxxx-shard-0
